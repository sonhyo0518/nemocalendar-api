DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nemocalendar"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="postmessage"

JWT_SECRET="replace-with-a-long-random-string"

# Google refresh token 암호화 (32바이트 hex = openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY="replace-with-64-char-hex-string"

CORS_ORIGINS="http://localhost:3000"
APP_PUBLIC_URL="http://localhost:3000"
PORT=5000

# Cloudflare R2 (배너 이미지 업로드)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_BASE_URL="https://your-public-domain.example.com"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"